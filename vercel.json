{
  "version": 2,
   "redirects": [
    { "source": "/news", "destination": "/blog", "permanent": true },
    { "source": "/news/:slug", "destination": "/blog/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server.js" },
    { "source": "/sitemap.xml", "destination": "/server.js" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/icon.svg", "destination": "/icon.svg" },
    { "source": "/((?!api/|sitemap.xml|robots.txt|icon.svg|assets/).*)", "destination": "/index.html" }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
