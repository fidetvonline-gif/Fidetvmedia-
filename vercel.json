{
  "functions": {
    "api/server.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/server"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/((?!api/|sitemap.xml|robots.txt).*)$",
      "destination": "/index.html"
    }
  ]
}
