{
  "functions": {
    "api/server.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/server"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/((?!api/|sitemap.xml|robots.txt|assets/|.*\\.(?:ico|png|jpg|jpeg|svg|js|css|json|webmanifest)$).*)$",
      "destination": "/api/server"
    }
  ]
}
